{
  "contract": "messaging/audience.py::reengagement_audience",
  "cases": [
    {
      "name": "an unsubscribe on mobile then a web signup that subscribes the address by default",
      "args": {
        "events": [
          {
            "source": "mobile",
            "type": "unsubscribe",
            "day": "2025-11-03",
            "ts": 1,
            "device_id": "d1",
            "email": "a@example.com",
            "email_verified": true,
            "traits": {
              "email_subscribed": false
            }
          },
          {
            "source": "web",
            "type": "signup",
            "day": "2025-11-10",
            "ts": 2,
            "user_id": "u1",
            "email": "a@example.com",
            "email_verified": true,
            "traits": {
              "email_subscribed": true
            }
          }
        ],
        "identity_map": {
          "$call": "ingestion/identity_map.py::IdentityMap.from_events",
          "args": {
            "events": [
              {
                "source": "mobile",
                "type": "unsubscribe",
                "day": "2025-11-03",
                "ts": 1,
                "device_id": "d1",
                "email": "a@example.com",
                "email_verified": true,
                "traits": {
                  "email_subscribed": false
                }
              },
              {
                "source": "web",
                "type": "signup",
                "day": "2025-11-10",
                "ts": 2,
                "user_id": "u1",
                "email": "a@example.com",
                "email_verified": true,
                "traits": {
                  "email_subscribed": true
                }
              }
            ]
          }
        },
        "inactive_since": "2026-01-01"
      }
    },
    {
      "name": "a later subscribe on the same identity replaces its unsubscribe",
