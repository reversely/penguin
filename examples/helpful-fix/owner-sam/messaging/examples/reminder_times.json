{
  "contract": "messaging/reminders.py::reminder_times",
  "cases": [
    {
      "name": "a contact in London asks for 09:00",
      "args": {
        "contacts": [
          {
            "user_id": "u1",
            "email": "u1@example.invalid",
            "utc_offset": {
              "$call": "shared/dates.py::parse_utc_offset",
              "args": {
                "text": "+00:00"
              }
            }
          }
        ],
        "now": {
          "$call": "shared/dates.py::parse_instant",
          "args": {
            "text": "2026-02-09T08:00:00+00:00"
          }
        },
        "local_hour": 9
      }
    },
    {
      "name": "a contact at UTC-08:00 asks for 09:00",
      "args": {
        "contacts": [
          {
            "user_id": "u2",
            "email": "u2@example.invalid",
            "utc_offset": {
              "$call": "shared/dates.py::parse_utc_offset",
              "args": {
                "text": "-08:00"
              }
            }
          }
        ],
        "now": {
          "$call": "shared/dates.py::parse_instant",
          "args": {
            "text": "2026-02-09T16:00:00+00:00"
          }
        },
        "local_hour": 9
      }
    }
  ]
}
