{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "penguin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The Agents SDK needs Node.js compatibility for crypto, streams and async context.
  "compatibility_flags": ["nodejs_compat"],

  // The built dashboard (`npm run build -w @penguin/dashboard`), served through Workers static
  // assets. The Worker runs first on every request, so it decides which paths are dashboard files
  // and adds the Content Security Policy to them (src/dashboard.ts).
  //
  // Dashboard sign-in reads GITHUB_OAUTH_CLIENT_ID (public, so a plain variable below), the
  // GITHUB_OAUTH_CLIENT_SECRET secret (`wrangler secret put`), and PENGUIN_DASHBOARD_OWNERS, which
  // maps GitHub logins to owner ids as `<login>:<owner>,<login>:<owner>`. Without the map nobody can
  // sign in. `wrangler dev` and `wrangler deploy` build the dashboard first.
  "vars": {
    "GITHUB_OAUTH_CLIENT_ID": "Ov23liQdtDavAZ3IhIVQ",
    "PENGUIN_DASHBOARD_OWNERS": "reversely:priya"
  },
  "build": {
    "command": "npm run build -w @penguin/dashboard",
    "cwd": "../..",
    "watch_dir": "../dashboard/src"
  },
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // routeAgentRequest() resolves /agents/<kebab-case binding>/<instance> to these bindings,
  // so each binding name matches its class name.
  "durable_objects": {
    "bindings": [
      { "name": "ProjectAgent", "class_name": "ProjectAgent" },
      { "name": "HuddleAgent", "class_name": "HuddleAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectAgent", "HuddleAgent"] }
  ],

  // One Artifacts namespace holds the base repo, the owner forks, the issues repo and the Huddle
  // repos. Artifacts creates the namespace on the first repo create. Artifacts has no local
  // simulator, so `remote` points `wrangler dev` at the real service.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "penguin", "remote": true }],

  // The Worker consumes the issues repo's `cf.artifacts.repo.pushed` events (setup inventory S4).
  // The subscription that feeds the queue is created on the dashboard, not here.
  "queues": {
    "consumers": [{ "queue": "penguin-issues-events" }]
  }
}
