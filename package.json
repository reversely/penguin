{
  "name": "penguin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node scripts/test.mjs fast",
    "test:copy": "node scripts/test.mjs copy",
    "test:slow": "node scripts/test.mjs slow",
    "test:live": "node scripts/test.mjs live",
    "test:all": "node scripts/test.mjs all",
    "typecheck": "tsc --noEmit && npm run typecheck -w @penguin/worker && npm run typecheck -w @penguin/dashboard",
    "walkthrough": "playwright test -c tests/walkthrough/playwright.config.ts",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
